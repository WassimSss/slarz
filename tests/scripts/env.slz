permissions {
    env "SLARZ_GOLDEN_SECRET";
    env "SLARZ_GOLDEN_UNDEFINED";
}

// Secrets live outside the script: it only knows their names.
secret: Text = check env("SLARZ_GOLDEN_SECRET");
print("secret length: " + to_text(length(secret)));

if missing: Text = env("SLARZ_GOLDEN_UNDEFINED") {
    print(missing);
} else {
    print("SLARZ_GOLDEN_UNDEFINED is not set");
}
