permissions { }

// A small export, as it could come out of a file.
export: Text = "name;amount\nAda;12.5\nGrace; 7\n";

var total: Float = 0.0;
var names: List<Text> = [];
for line in lines(export) {
    if not starts_with(line, "name;") {
        columns: List<Text> = split(line, ";");
        name: Text = get(columns, 0) otherwise "?";
        if amount: Text = get(columns, 1) {
            total = total + (parse_float(trim(amount)) otherwise 0.0);
        }
        names = append(names, to_upper(name));
    }
}

print(join(names, ", "));
print("total: " + format_decimals(total, 2));
print(replace_all("2026-10-01", "-", "/"));
print(contains(export, "Grace") and ends_with(export, "\n"));
