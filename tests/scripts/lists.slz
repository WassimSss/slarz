permissions { }

names: List<Text> = ["Ada", "Grace"];
var everyone: List<Text> = names;
everyone = append(everyone, "Linus");

// `names` is untouched: modifying a list never changes another variable.
print(names);
print(everyone);
print(length(everyone));

