permissions { }

function size(n: Int) -> Text {
    if n < 10 {
        return "small";
    } else if n < 100 {
        return "medium";
    } else {
        return "large";
    }
}

print(size(5));
print(size(50));
print(size(500));
print(1 < 2 and not (3 == 4));
// `or` stops at the first true value: `missing` is never looked at.
print(true or missing);