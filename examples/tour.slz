permissions { }

// Constants never change; `var` marks what does.
rate: Float = 0.2;
var total: Float = 0.0;
var count: Int = 0;

function with_tax(amount: Float) -> Float {
    return amount + amount * rate;
}

while count < 3 {
    total = total + with_tax(100.0);
    count = count + 1;
}

if total > 300.0 and not (count == 0) {
    print("Total with tax:");
    print(total);
} else {
    print("Nothing to pay");
}
